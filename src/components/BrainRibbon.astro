---
---
<div class="brain-perspective w-full aspect-[4/3]">
  <div class="stage">
  <svg id="brain" viewBox="0 0 960 720" role="img" aria-label="A human brain in lateral profile, surface formed by one continuous ribbon of binary and behavioral-science terms" style="width:100%;height:100%;display:block;">
    <defs id="defs">
      <path id="sil" fill="none" d="
        M 110 320
        C 112 250 160 170 250 135
        C 330 105 430  92 520 100
        C 620 108 730 150 800 220
        C 845 265 868 320 858 368
        C 852 392 830 402 806 408
        C 850 430 868 470 852 505
        C 838 538 790 560 742 552
        C 716 548 696 538 684 528
        C 678 556 668 590 648 614
        C 638 626 622 626 616 612
        C 610 596 612 572 606 552
        C 588 540 566 534 548 532
        C 480 540 380 540 310 512
        C 268 496 240 478 232 458
        C 200 452 168 436 150 412
        C 122 384 108 352 110 320 Z
      "></path>
      <clipPath id="clip"><path id="clipShape"></path></clipPath>
      <radialGradient id="brainDepth" cx="44%" cy="46%" r="56%" gradientUnits="objectBoundingBox">
        <stop offset="0%"   stop-color="#ede7d8" stop-opacity="0"></stop>
        <stop offset="65%"  stop-color="#d9d2be" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="#cec6b0" stop-opacity="0.34"></stop>
      </radialGradient>
      <filter id="brainNoise" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.013 0.017" numOctaves="5" seed="9" result="noise"></feTurbulence>
        <feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.836
                  0 0 0 0 0.812
                  0 0 0 0 0.769
                  1.5 0 0 0 -0.68"></feColorMatrix>
      </filter>
    </defs>

    <path id="depthFill" fill="url(#brainDepth)" clip-path="url(#clip)"></path>
    <rect x="0" y="0" width="960" height="720" filter="url(#brainNoise)" clip-path="url(#clip)"></rect>
    <g id="grp" clip-path="url(#clip)"></g>
    <path id="outline" fill="none" stroke-width="2.5" stroke-linejoin="round" stroke-opacity="0.28" style="stroke: oklch(0.301 0.073 257.068); will-change: stroke-width, stroke-opacity, filter;"></path>
  </svg>
  </div>
</div>

<style>
  .brain-perspective { perspective: 1400px; }
  .stage {
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .stage.dragging { cursor: grabbing; }
  .stage svg { pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .stage { cursor: default; }
  }
</style>

<script>
const RIBBON_SPEED = 18;
const TEXT_DENSITY = 1.0;
const ROW_PITCH    = 38;   // vertical gap between folds; raised with FONT_BASE for legibility
const FONT_BASE    = 16;   // glyph size in viewBox units (was 12.5) — bump to read more easily
const INSET = 14;
const AMP1  = 3.8,  FREQ1 = 0.034;
const AMP2  = 1.6,  FREQ2 = 0.011;
const MINW  = 48;

const NS   = 'http://www.w3.org/2000/svg';
const svg  = document.getElementById('brain') as SVGSVGElement;
const grp  = document.getElementById('grp')!;
const defs = document.getElementById('defs')!;
const sil  = document.getElementById('sil') as SVGPathElement;

const silD = sil.getAttribute('d')!;
document.getElementById('clipShape')!.setAttribute('d', silD);
document.getElementById('depthFill')!.setAttribute('d', silD);
document.getElementById('outline')!.setAttribute('d', silD);

const TERMS = [
  'anchoring', 'loss aversion', 'social proof', 'priming',
  'framing effect', 'scarcity', 'reciprocity', 'cognitive load',
  'heuristic', 'salience', 'default bias', 'mere exposure',
  'dual-process', 'nudge', 'endowment effect', 'peak-end rule',
  'availability bias', 'choice architecture'
];

function mulberry32(a: number) {
  return function () {
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
const rnd  = mulberry32(20260610);
const bits = (n: number) => { let s = ''; for (let i = 0; i < n; i++) s += rnd() < 0.5 ? '0' : '1'; return s; };

function makeSegments() {
  const segs: { text: string; isterm: boolean }[] = [];
  let t = 0;
  for (let i = 0; i < 28; i++) {
    if (i % 2 === 0) {
      segs.push({ text: TERMS[t++ % TERMS.length] + '   ', isterm: true });
    } else {
      const b = bits(4 + ((rnd() * 5) | 0)) + ' ' + bits(4 + ((rnd() * 4) | 0));
      segs.push({ text: b + '   ', isterm: false });
    }
  }
  return segs;
}

const ROW = ROW_PITCH / TEXT_DENSITY;
const SAMPLES = 700, poly: [number, number][] = [];
const totalLen = sil.getTotalLength();
for (let i = 0; i < SAMPLES; i++) {
  const p = sil.getPointAtLength(totalLen * i / SAMPLES);
  poly.push([p.x, p.y]);
}

function spanAt(y: number) {
  const xs: number[] = [];
  for (let i = 0; i < poly.length; i++) {
    const [x1, y1] = poly[i], [x2, y2] = poly[(i + 1) % poly.length];
    if ((y1 <= y) !== (y2 <= y))
      xs.push(x1 + (y - y1) * (x2 - x1) / (y2 - y1));
  }
  xs.sort((a, b) => a - b);
  let best: [number, number] | null = null;
  for (let i = 0; i + 1 < xs.length; i += 2) {
    const a = xs[i] + INSET, b = xs[i + 1] - INSET;
    if (b - a >= MINW && (!best || b - a > best[1] - best[0])) best = [a, b];
  }
  return best;
}

const rows: { y: number; a: number; b: number }[] = [];
for (let y = 128; y <= 505; y += ROW) {
  const s = spanAt(y);
  if (s) rows.push({ y, a: s[0], b: s[1] });
}

const pts: [number, number][] = [];
rows.forEach((r, i) => {
  const dir  = i % 2 === 0 ? 1 : -1;
  const from = dir > 0 ? r.a : r.b;
  const to   = dir > 0 ? r.b : r.a;
  const phase = i * 1.31;

  for (let x = from; dir > 0 ? x <= to : x >= to; x += 6 * dir) {
    const edge  = Math.min(Math.abs(x - r.a), Math.abs(r.b - x));
    const taper = Math.min(1, edge / 34);
    const wob   = taper * (AMP1 * Math.sin(x * FREQ1 + phase) +
                            AMP2 * Math.sin(x * FREQ2 + phase * 1.7));
    pts.push([x, r.y + wob]);
  }

  if (i < rows.length - 1) {
    const n  = rows[i + 1];
    const xs = (-1 * dir) > 0 ? n.a : n.b;
    const cx = to + dir * ROW * 1.1;
    const cy = (r.y + n.y) / 2;
    for (let t = 0.14; t <= 1.0001; t += 0.14) {
      const u = 1 - t;
      pts.push([
        u * u * to   + 2 * u * t * cx + t * t * xs,
        u * u * r.y  + 2 * u * t * cy + t * t * n.y
      ]);
    }
  }
});

(function tail() {
  const last = pts[pts.length - 1];
  const W: [number, number][] = [last, [604, 522], [648, 548], [638, 580], [624, 604]];
  for (let s = 0; s < W.length - 1; s++) {
    const p0 = W[Math.max(0, s - 1)], p1 = W[s],
          p2 = W[s + 1],              p3 = W[Math.min(W.length - 1, s + 2)];
    for (let t = 1 / 12; t <= 1.0001; t += 1 / 12) {
      const t2 = t * t, t3 = t2 * t;
      pts.push([
        0.5 * ((2*p1[0]) + (-p0[0]+p2[0])*t + (2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*t2 + (-p0[0]+3*p1[0]-3*p2[0]+p3[0])*t3),
        0.5 * ((2*p1[1]) + (-p0[1]+p2[1])*t + (2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*t2 + (-p0[1]+3*p1[1]-3*p2[1]+p3[1])*t3)
      ]);
    }
  }
})();

let d = 'M ' + pts[0][0].toFixed(1) + ' ' + pts[0][1].toFixed(1);
for (let i = 1; i < pts.length; i++)
  d += ' L ' + pts[i][0].toFixed(1) + ' ' + pts[i][1].toFixed(1);

const ribbon = document.createElementNS(NS, 'path');
ribbon.setAttribute('id', 'ribbon');
ribbon.setAttribute('d', d);
ribbon.setAttribute('fill', 'none');
defs.appendChild(ribbon);

const fontSize = FONT_BASE / Math.sqrt(TEXT_DENSITY);
const FONT = "'Space Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace";
const textEl = document.createElementNS(NS, 'text');
textEl.setAttribute('font-family', FONT);
textEl.setAttribute('font-size', String(fontSize));
textEl.setAttribute('letter-spacing', '0.5');
textEl.setAttribute('fill', 'var(--color-indigo)');
// Place glyphs at exact sub-pixel positions instead of snapping each to the
// pixel grid every frame — kills the "skitter" as the text scrolls the path.
textEl.setAttribute('text-rendering', 'geometricPrecision');

const tp = document.createElementNS(NS, 'textPath');
tp.setAttribute('href', '#ribbon');
textEl.appendChild(tp);
grp.appendChild(textEl);

const segs = makeSegments();
const tileText = segs.map(s => s.text).join('');
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ── interaction tunables ───────────────────────────────────
   BASE_SPEED      idle drift along the ribbon (px/sec)
   STEER           cursor X nudges the flow faster/backwards
   GLIDE           how long a fling coasts before resting (0–100)
   PARALLAX_*      how hard the brain leans toward the cursor
   PRESS_*         extra lean + scale "pop" while actively grabbing
   ─────────────────────────────────────────────────────────── */
const BASE_SPEED     = RIBBON_SPEED;
const STEER          = true;
const STEER_STRENGTH = 55;
const GLIDE          = 55;
const PARALLAX       = !reduceMotion;
const PARALLAX_MOVE  = 20;   // px of translate at the edges (was 10)
const PARALLAX_ROT   = 10;   // deg of 3D rotation at the edges (was 5)
const PRESS_BOOST    = 1.8;  // tilt multiplier while grabbing
const PRESS_SCALE    = 0.04; // scale pop while grabbing
const DRAG_GAIN      = 1.4;  // how strongly a drag scrubs the ribbon
const FLING_CLAMP    = 2400; // max momentum handed off on release

document.fonts.ready.then(() => {
  const stage = document.querySelector('.stage') as HTMLElement;

  // The component lives in a `hidden lg:block` container, so on smaller
  // viewports the stage has zero width and text measures 0 — which would
  // blow `reps` up into hundreds of thousands of tspans. Defer the build
  // until the stage is actually laid out, then run exactly once.
  let started = false;
  function start() {
    if (started || stage.getBoundingClientRect().width === 0) return;
    started = true;
    build();
  }
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(() => { start(); if (started) ro.disconnect(); });
    ro.observe(stage);
  }

  function build() {
  const pathLen = (ribbon as SVGPathElement).getTotalLength();

  const probe = document.createElementNS(NS, 'text');
  probe.setAttribute('font-family', FONT);
  probe.setAttribute('font-size', String(fontSize));
  probe.setAttribute('letter-spacing', '0.5');
  probe.textContent = tileText;
  probe.setAttribute('opacity', '0');
  svg.appendChild(probe);
  const tileLen = (probe as SVGTextElement).getComputedTextLength() || 1;
  svg.removeChild(probe);

  const reps = Math.ceil((pathLen + tileLen) / tileLen) + 1;
  tp.textContent = '';
  for (let r = 0; r < reps; r++) {
    segs.forEach(seg => {
      const tspan = document.createElementNS(NS, 'tspan');
      tspan.textContent = seg.text;
      tspan.setAttribute('fill', seg.isterm ? 'var(--color-indigo)' : 'var(--color-orange)');
      tp.appendChild(tspan);
    });
  }

  if (reduceMotion) {
    tp.setAttribute('startOffset', (-tileLen * 0.4).toFixed(1));
    return;
  }

  /* ══ interactive physics ══════════════════════════════════
     The ribbon's position along the path is one scalar, `offset`.
     Velocity eases toward base drift + cursor "current". Dragging
     scrubs offset directly and, on release, hands its measured
     speed back as momentum that glides to rest. */
  let offset   = tileLen * 0.4;
  let velocity = BASE_SPEED;

  const outline = document.getElementById('outline') as SVGPathElement;

  let dragging = false, lastX = 0, lastT = 0, measuredVel = 0;
  let nx = 0, ny = 0, overStage = false;   // cursor, normalized −1..1
  let px = 0, py = 0, press = 0;            // eased parallax + grab state
  let glow = 0;                            // eased cursor-proximity highlight

  const scaleNow = () => 960 / stage.getBoundingClientRect().width;
  const friction = () => 12 * Math.pow(0.05, GLIDE / 100);

  function readCursor(e: PointerEvent) {
    const r = stage.getBoundingClientRect();
    nx = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width  / 2)) / (r.width  / 2)));
    ny = Math.max(-1, Math.min(1, (e.clientY - (r.top  + r.height / 2)) / (r.height / 2)));
  }

  stage.addEventListener('pointerdown', e => {
    e.preventDefault();                       // no text selection / drag-image
    dragging = true; overStage = true;
    stage.classList.add('dragging');
    stage.setPointerCapture?.(e.pointerId);
    lastX = e.clientX; lastT = performance.now(); measuredVel = 0;
    readCursor(e);
  });

  stage.addEventListener('pointermove', e => {
    overStage = true;
    readCursor(e);
    if (!dragging) return;
    const now = performance.now();
    const dt  = Math.max((now - lastT) / 1000, 0.001);
    const dOff = -(e.clientX - lastX) * scaleNow() * DRAG_GAIN;
    offset += dOff;
    measuredVel = measuredVel * 0.6 + (dOff / dt) * 0.4;   // EMA → momentum
    lastX = e.clientX; lastT = now;
  });

  function endDrag() {
    if (!dragging) return;
    dragging = false;
    stage.classList.remove('dragging');
    velocity = Math.max(-FLING_CLAMP, Math.min(FLING_CLAMP, measuredVel));
  }
  stage.addEventListener('pointerup', endDrag);
  stage.addEventListener('pointercancel', endDrag);
  stage.addEventListener('pointerleave', () => {
    overStage = false;
    if (!dragging) { nx = 0; ny = 0; }
  });

  /* double-click flings the ribbon — a little playful spin */
  stage.addEventListener('dblclick', () => { velocity = 1100; });

  let last = performance.now();
  (function frame(now: number) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;

    if (!dragging) {
      let target = BASE_SPEED;
      if (STEER && overStage) target += STEER_STRENGTH * nx;
      velocity = target + (velocity - target) * Math.exp(-friction() * dt);
      offset  += velocity * dt;
    }

    offset = ((offset % tileLen) + tileLen) % tileLen;
    tp.setAttribute('startOffset', (-offset).toFixed(2));

    /* parallax tilt — the brain leans toward the cursor, amplified
       while grabbing for a dramatic, playful response */
    const tnx = (PARALLAX && overStage) ? nx : 0;
    const tny = (PARALLAX && overStage) ? ny : 0;
    px    += (tnx - px) * Math.min(1, dt * 6);
    py    += (tny - py) * Math.min(1, dt * 6);
    press += ((dragging ? 1 : 0) - press) * Math.min(1, dt * 8);
    const boost = 1 + (PRESS_BOOST - 1) * press;
    stage.style.transform =
      `translate(${(-px * PARALLAX_MOVE * boost).toFixed(2)}px, ${(-py * PARALLAX_MOVE * 0.8 * boost).toFixed(2)}px) ` +
      `rotateY(${(px * PARALLAX_ROT * boost).toFixed(2)}deg) rotateX(${(-py * PARALLAX_ROT * boost).toFixed(2)}deg) ` +
      `scale(${(1 + PRESS_SCALE * press).toFixed(3)})`;

    /* cursor-proximity glow — the outline brightens and thickens as the
       cursor nears the brain (strongest at center), hinting "grab me".
       A press deepens it further. */
    const dist   = Math.min(1, Math.hypot(nx, ny));
    const target = PARALLAX ? (overStage ? Math.max(press, 1 - dist * 0.7) : 0) : 0;
    glow += (target - glow) * Math.min(1, dt * 7);
    if (glow > 0.005) {
      outline.setAttribute('stroke-width', (2.5 + glow * 1.5).toFixed(2));
      outline.setAttribute('stroke-opacity', (0.28 + glow * 0.34).toFixed(3));
      outline.style.filter = `drop-shadow(0 0 ${(glow * 7).toFixed(1)}px rgba(192,106,44,${(glow * 0.45).toFixed(2)}))`;
    } else {
      outline.setAttribute('stroke-width', '2.5');
      outline.setAttribute('stroke-opacity', '0.28');
      outline.style.filter = 'none';
    }

    requestAnimationFrame(frame);
  })(last);
  }

  start();
});
</script>
