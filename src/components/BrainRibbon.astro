---
---
<div class="stage w-full aspect-[4/3]">
  <svg id="brain" viewBox="0 0 960 720" role="img" aria-label="A human brain in lateral profile, surface formed by one continuous ribbon of binary and behavioral-science terms" style="width:100%;height:100%;display:block;">
    <defs id="defs">
      <path id="sil" fill="none" d="
        M 110 320
        C 112 250 160 170 250 135
        C 330 105 430  92 520 100
        C 620 108 730 150 800 220
        C 845 265 868 320 858 368
        C 852 392 830 402 806 408
        C 850 430 868 470 852 505
        C 838 538 790 560 742 552
        C 716 548 696 538 684 528
        C 678 556 668 590 648 614
        C 638 626 622 626 616 612
        C 610 596 612 572 606 552
        C 588 540 566 534 548 532
        C 480 540 380 540 310 512
        C 268 496 240 478 232 458
        C 200 452 168 436 150 412
        C 122 384 108 352 110 320 Z
      "></path>
      <clipPath id="clip"><path id="clipShape"></path></clipPath>
      <radialGradient id="brainDepth" cx="44%" cy="46%" r="56%" gradientUnits="objectBoundingBox">
        <stop offset="0%"   stop-color="#ede7d8" stop-opacity="0"></stop>
        <stop offset="65%"  stop-color="#d9d2be" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="#cec6b0" stop-opacity="0.34"></stop>
      </radialGradient>
      <filter id="brainNoise" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.013 0.017" numOctaves="5" seed="9" result="noise"></feTurbulence>
        <feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.836
                  0 0 0 0 0.812
                  0 0 0 0 0.769
                  1.5 0 0 0 -0.68"></feColorMatrix>
      </filter>
    </defs>

    <path id="depthFill" fill="url(#brainDepth)" clip-path="url(#clip)"></path>
    <rect x="0" y="0" width="960" height="720" filter="url(#brainNoise)" clip-path="url(#clip)"></rect>
    <g id="grp" clip-path="url(#clip)"></g>
    <path id="outline" fill="none" stroke-width="2.5" stroke-linejoin="round" style="stroke: oklch(0.301 0.073 257.068 / 0.28);"></path>
  </svg>
</div>

<script>
const RIBBON_SPEED = 18;
const TEXT_DENSITY = 1.0;
const ROW_PITCH    = 30;
const INSET = 14;
const AMP1  = 3.8,  FREQ1 = 0.034;
const AMP2  = 1.6,  FREQ2 = 0.011;
const MINW  = 48;

const NS   = 'http://www.w3.org/2000/svg';
const svg  = document.getElementById('brain') as SVGSVGElement;
const grp  = document.getElementById('grp')!;
const defs = document.getElementById('defs')!;
const sil  = document.getElementById('sil') as SVGPathElement;

const silD = sil.getAttribute('d')!;
document.getElementById('clipShape')!.setAttribute('d', silD);
document.getElementById('depthFill')!.setAttribute('d', silD);
document.getElementById('outline')!.setAttribute('d', silD);

const TERMS = [
  'anchoring', 'loss aversion', 'social proof', 'priming',
  'framing effect', 'scarcity', 'reciprocity', 'cognitive load',
  'heuristic', 'salience', 'default bias', 'mere exposure',
  'dual-process', 'nudge', 'endowment effect', 'peak-end rule',
  'availability bias', 'choice architecture'
];

function mulberry32(a: number) {
  return function () {
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
const rnd  = mulberry32(20260610);
const bits = (n: number) => { let s = ''; for (let i = 0; i < n; i++) s += rnd() < 0.5 ? '0' : '1'; return s; };

function makeSegments() {
  const segs: { text: string; isterm: boolean }[] = [];
  let t = 0;
  for (let i = 0; i < 28; i++) {
    if (i % 2 === 0) {
      segs.push({ text: TERMS[t++ % TERMS.length] + '   ', isterm: true });
    } else {
      const b = bits(4 + ((rnd() * 5) | 0)) + ' ' + bits(4 + ((rnd() * 4) | 0));
      segs.push({ text: b + '   ', isterm: false });
    }
  }
  return segs;
}

const ROW = ROW_PITCH / TEXT_DENSITY;
const SAMPLES = 700, poly: [number, number][] = [];
const totalLen = sil.getTotalLength();
for (let i = 0; i < SAMPLES; i++) {
  const p = sil.getPointAtLength(totalLen * i / SAMPLES);
  poly.push([p.x, p.y]);
}

function spanAt(y: number) {
  const xs: number[] = [];
  for (let i = 0; i < poly.length; i++) {
    const [x1, y1] = poly[i], [x2, y2] = poly[(i + 1) % poly.length];
    if ((y1 <= y) !== (y2 <= y))
      xs.push(x1 + (y - y1) * (x2 - x1) / (y2 - y1));
  }
  xs.sort((a, b) => a - b);
  let best: [number, number] | null = null;
  for (let i = 0; i + 1 < xs.length; i += 2) {
    const a = xs[i] + INSET, b = xs[i + 1] - INSET;
    if (b - a >= MINW && (!best || b - a > best[1] - best[0])) best = [a, b];
  }
  return best;
}

const rows: { y: number; a: number; b: number }[] = [];
for (let y = 128; y <= 505; y += ROW) {
  const s = spanAt(y);
  if (s) rows.push({ y, a: s[0], b: s[1] });
}

const pts: [number, number][] = [];
rows.forEach((r, i) => {
  const dir  = i % 2 === 0 ? 1 : -1;
  const from = dir > 0 ? r.a : r.b;
  const to   = dir > 0 ? r.b : r.a;
  const phase = i * 1.31;

  for (let x = from; dir > 0 ? x <= to : x >= to; x += 6 * dir) {
    const edge  = Math.min(Math.abs(x - r.a), Math.abs(r.b - x));
    const taper = Math.min(1, edge / 34);
    const wob   = taper * (AMP1 * Math.sin(x * FREQ1 + phase) +
                            AMP2 * Math.sin(x * FREQ2 + phase * 1.7));
    pts.push([x, r.y + wob]);
  }

  if (i < rows.length - 1) {
    const n  = rows[i + 1];
    const xs = (-1 * dir) > 0 ? n.a : n.b;
    const cx = to + dir * ROW * 1.1;
    const cy = (r.y + n.y) / 2;
    for (let t = 0.14; t <= 1.0001; t += 0.14) {
      const u = 1 - t;
      pts.push([
        u * u * to   + 2 * u * t * cx + t * t * xs,
        u * u * r.y  + 2 * u * t * cy + t * t * n.y
      ]);
    }
  }
});

(function tail() {
  const last = pts[pts.length - 1];
  const W: [number, number][] = [last, [604, 522], [648, 548], [638, 580], [624, 604]];
  for (let s = 0; s < W.length - 1; s++) {
    const p0 = W[Math.max(0, s - 1)], p1 = W[s],
          p2 = W[s + 1],              p3 = W[Math.min(W.length - 1, s + 2)];
    for (let t = 1 / 12; t <= 1.0001; t += 1 / 12) {
      const t2 = t * t, t3 = t2 * t;
      pts.push([
        0.5 * ((2*p1[0]) + (-p0[0]+p2[0])*t + (2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*t2 + (-p0[0]+3*p1[0]-3*p2[0]+p3[0])*t3),
        0.5 * ((2*p1[1]) + (-p0[1]+p2[1])*t + (2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*t2 + (-p0[1]+3*p1[1]-3*p2[1]+p3[1])*t3)
      ]);
    }
  }
})();

let d = 'M ' + pts[0][0].toFixed(1) + ' ' + pts[0][1].toFixed(1);
for (let i = 1; i < pts.length; i++)
  d += ' L ' + pts[i][0].toFixed(1) + ' ' + pts[i][1].toFixed(1);

const ribbon = document.createElementNS(NS, 'path');
ribbon.setAttribute('id', 'ribbon');
ribbon.setAttribute('d', d);
ribbon.setAttribute('fill', 'none');
defs.appendChild(ribbon);

const fontSize = 12.5 / Math.sqrt(TEXT_DENSITY);
const FONT = "'Space Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace";
const textEl = document.createElementNS(NS, 'text');
textEl.setAttribute('font-family', FONT);
textEl.setAttribute('font-size', String(fontSize));
textEl.setAttribute('letter-spacing', '0.5');
textEl.setAttribute('fill', 'var(--color-indigo)');

const tp = document.createElementNS(NS, 'textPath');
tp.setAttribute('href', '#ribbon');
textEl.appendChild(tp);
grp.appendChild(textEl);

const segs = makeSegments();
const tileText = segs.map(s => s.text).join('');
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

document.fonts.ready.then(() => {
  const pathLen = (ribbon as SVGPathElement).getTotalLength();

  const probe = document.createElementNS(NS, 'text');
  probe.setAttribute('font-family', FONT);
  probe.setAttribute('font-size', String(fontSize));
  probe.setAttribute('letter-spacing', '0.5');
  probe.textContent = tileText;
  probe.setAttribute('opacity', '0');
  svg.appendChild(probe);
  const tileLen = (probe as SVGTextElement).getComputedTextLength() || 1;
  svg.removeChild(probe);

  const reps = Math.ceil((pathLen + tileLen) / tileLen) + 1;
  tp.textContent = '';
  for (let r = 0; r < reps; r++) {
    segs.forEach(seg => {
      const tspan = document.createElementNS(NS, 'tspan');
      tspan.textContent = seg.text;
      tspan.setAttribute('fill', seg.isterm ? 'var(--color-indigo)' : 'var(--color-orange)');
      tp.appendChild(tspan);
    });
  }

  if (reduceMotion) {
    tp.setAttribute('startOffset', (-tileLen * 0.4).toFixed(1));
    return;
  }

  let offset = 0, last = performance.now();
  (function frame(now: number) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    offset = (offset + RIBBON_SPEED * dt) % tileLen;
    tp.setAttribute('startOffset', (-offset).toFixed(2));
    requestAnimationFrame(frame);
  })(last);
});
</script>
