<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="100%" height="100%">
  <style>
    /* Minimalist Apple-esque Styling */
    .bg { fill: #e6e5db; }
    
    .grid-line {
      stroke: #142e52;
      stroke-width: 1;
      opacity: 0.08;
    }

    /* Common Animation Properties */
    .animated-path {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      /* Using pathLength="100" in markup normalizes lengths to exactly 100 */
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
    }

    /* Orange Brand Arc - Smooth, patient, lingers after the tactics vanish */
    .brand-arc {
      stroke: #f28f2c;
      stroke-width: 6;
      animation:
        draw-arc 8s var(--ease-draw) infinite,
        exit-arc 8s linear infinite;
    }

    /* Blue Tactics Chaos - draws in stop-start bursts, vanishes abruptly */
    .tactics-chaos {
      stroke: #142e52;
      stroke-width: 4;
      animation:
        draw-tactics 8s var(--ease-draw) infinite,
        exit-tactics 8s linear infinite;
      /* Browsers without linear() drop this declaration and keep the
         smooth curve from the shorthand above — same finish time either way */
      animation-timing-function:
        linear(0, 0.12 14%, 0.14 26%, 0.38 34%, 0.41 52%, 0.68 60%, 0.71 78%, 1),
        linear;
    }

    /* Keyframes */
    /* Tactics rush ahead and finish first… */
    @keyframes draw-tactics {
      0%, 10% { stroke-dashoffset: 100; }
      60%, 100% { stroke-dashoffset: 0; }
    }

    /* …the brand arc starts later and is still climbing after they're gone */
    @keyframes draw-arc {
      0%, 12% { stroke-dashoffset: 100; }
      80%, 100% { stroke-dashoffset: 0; }
    }

    /* "Broken quickly": tactics evaporate soon after they peak */
    @keyframes exit-tactics {
      0%, 68% { opacity: 1; }
      73%, 100% { opacity: 0; }
    }

    /* "Built slowly": the brand line arrives last and persists longest */
    @keyframes exit-arc {
      0%, 85% { opacity: 1; }
      97%, 100% { opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .brand-arc,
      .tactics-chaos {
        animation: none;
        stroke-dashoffset: 0; /* poster frame: chart fully drawn */
      }
    }
  </style>

  <rect class="bg" width="800" height="400" rx="16" />

  <g class="grid-line">
    <line x1="80" y1="320" x2="720" y2="320" />
    <line x1="80" y1="240" x2="720" y2="240" />
    <line x1="80" y1="160" x2="720" y2="160" />
    <line x1="80" y1="80" x2="720" y2="80" />
  </g>

  <path d="M 80 80 L 80 320 L 720 320" fill="none" stroke="#142e52" stroke-width="2" opacity="0.3" stroke-linecap="round" stroke-linejoin="round"/>

  <g>

    <path class="animated-path tactics-chaos" pathLength="100" d="M 80 320 L 120 280 L 150 300 L 180 240 L 220 270 L 260 180 L 300 220 L 350 120 L 400 180 L 450 80 L 490 150 L 530 60 L 570 160 L 610 120 L 660 260 L 690 240 L 720 320" />

    <path class="animated-path brand-arc" pathLength="100" d="M 80 320 C 250 320, 500 180, 720 80" />

  </g>

</svg>
