---
import ScrollFadeIn from "./ScrollFadeIn.astro";

const steps = ["A free intro call", "Written diagnostic report", "Build or advise"];
---

<ScrollFadeIn delay={300}>
  <div class="mt-12 rounded-lg bg-linen/50 ring-1 ring-inset ring-slate-blue/5 shadow-[inset_0_1px_0_rgba(255,255,255,0.7)] px-6 py-6 md:px-8 md:py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-x-8 gap-y-4">
    <div class="flex flex-col sm:flex-row sm:items-baseline gap-x-4 gap-y-2">
      <span class="font-mono text-[13px] uppercase tracking-widest text-orange shrink-0">
        How this works
      </span>
      <p class="font-body text-[15px] md:text-base text-indigo font-medium">
        {steps.map((step, i) => (
          <>
            {i > 0 && <span class="text-orange px-1.5" aria-hidden="true">&rarr;</span>}
            {step}
          </>
        ))}
      </p>
    </div>
    <a
      href="/services"
      class="group inline-flex items-center text-orange font-mono text-[13px] uppercase tracking-widest hover:text-orange/80 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-orange rounded-sm shrink-0"
    >
      See how it works
      <svg class="w-4 h-4 mt-[1px] ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</ScrollFadeIn>
