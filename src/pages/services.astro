---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollFadeIn from '../components/ScrollFadeIn.astro';
import HowItWorks from '../components/HowItWorks.astro';
import BottomCTA from '../components/BottomCTA.astro';

const services = [
  {
    number: "01",
    name: "The Diagnostic",
    tagline: "Uncover the factors quietly stalling your growth — in weeks, not months.",
    idealFor: "SaaS companies whose activation, conversion, or retention numbers have flattened — and whose next idea can't just be more A/B tests.",
    description: "<p>I examine your positioning, ad copy, site, funnel, and lifecycle against how buyers actually make decisions. You get a written <strong class=\"font-semibold text-indigo\">Decision-Path Diagnosis</strong>: your 3–5 highest-leverage problems, the behavioral reason behind each, and a sequenced 90-day plan specific enough that you can execute it without me. Fixed fee, fixed timeline, yours to keep.</p>",
  },
  {
    number: "02",
    name: "Behavioral Architecture Sprint",
    tagline: "Build the marketing systems that compound.",
    idealFor: "Founders who have funnel leaks and want them fixed with systems built for the long term.",
    description: "<p>I rebuild the decision path — ad copy, landing pages, onboarding flows, lifecycle messaging, pricing-page logic — inside your existing tools, grounded in how your specific customers evaluate and choose. You get a working system, full documentation, and the keys.</p><p><em>Metrics we build toward:</em> activation rate, trial-to-paid conversion, and net revenue retention.</p><p>I'm not a short-term growth hacker. The Sprint delivers a working system; the results compound over quarters through brand and lifecycle marketing.</p>",
  },
  {
    number: "03",
    name: "Strategic Advisory",
    tagline: "Ongoing judgment and honest pushback for the tough calls.",
    idealFor: "Founders starting — or stuck in — a repositioning, rebrand, or pivot.",
    description: "<p>An ongoing advisory relationship with someone who can afford to be honest because I don't have to play politics. I will pressure-test strategies, name assumptions, and hold the line on long-term brand decisions when short-term metrics tempt you off it. You make sharper calls, faster, with fewer expensive reversals.</p>",
  }
];
---

<BaseLayout
  title="Services — Thomas Sloan"
  description="Marketing strategy engagements for B2B SaaS founders — diagnosis, positioning, and the judgment calls your team has been avoiding."
>
  <div class="pt-16 pb-32 px-6">
    <div class="max-w-[1200px] w-full mx-auto">
      <ScrollFadeIn delay={0}>
        <h1 class="text-indigo mb-8">
          Services
        </h1>
        <p class="font-body text-[18px] md:text-[20px] text-slate-blue max-w-[700px] leading-relaxed mb-4">
          Most marketing doesn't fail from poor execution — it fails from avoided decisions: how you become distinctive, what you're signaling to buyers, and what <em>not</em> to do.
        </p>
        <p class="font-body text-[18px] md:text-[20px] text-slate-blue max-w-[700px] leading-relaxed mb-16">
          I work with SaaS founders and marketing leaders (roughly Series A–C, $1M–$30M) who want their marketing fundamentally improved, not just further optimized.
        </p>
      </ScrollFadeIn>

      <!-- How This Works -->
      <HowItWorks />

      <!-- Accordion Services -->
      <div id="services-accordion" class="border-t border-slate-blue/15">
        {services.map((svc, i) => (
          <ScrollFadeIn delay={(i * 100) as any}>
            <div class="service-item border-b border-slate-blue/15">
              <!-- Always-visible header -->
              <button
                class="service-trigger w-full text-left py-8 md:py-10 flex items-start gap-6 md:gap-10 group focus:outline-none focus-visible:ring-2 focus-visible:ring-orange focus-visible:ring-inset rounded-sm"
                aria-expanded="false"
              >
                <!-- Number -->
                <span class="font-mono text-[13px] text-slate-blue/40 tracking-widest uppercase shrink-0 pt-1">
                  {svc.number}
                </span>

                <!-- Name + tagline -->
                <div class="flex-1 min-w-0">
                  <h2 class="font-display font-semibold text-[1.5rem] md:text-[1.75rem] text-indigo group-hover:text-indigo/80 transition-colors leading-snug mb-2">
                    {svc.name}
                  </h2>
                  <p class="font-body text-[1rem] text-slate-blue leading-relaxed">
                    {svc.tagline}
                  </p>
                  <p class="font-body text-[0.9375rem] text-slate-blue italic mt-2 max-w-[60ch]">
                    Best for: {svc.idealFor}
                  </p>
                </div>

                <!-- Chevron -->
                <span
                  class="service-chevron shrink-0 mt-1 w-10 h-10 flex items-center justify-center text-orange"
                  aria-hidden="true"
                >
                  <svg class="w-7 h-7 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </button>

              <!-- Expandable body -->
              <div
                class="service-body grid grid-rows-[0fr] transition-all duration-500 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] opacity-0"
              >
                <div class="overflow-hidden min-h-0">
                  <div class="pb-10 pl-[calc(2rem+1.5625rem)] md:pl-[calc(2.5rem+1.5625rem)]">
                    <div
                      class="font-body text-lg text-slate-blue leading-relaxed mb-8 max-w-[680px] [&>p]:mb-4 [&>p:last-child]:mb-0"
                      set:html={svc.description}
                    />

                    <a
                      href="/contact"
                      class="inline-block bg-transparent text-indigo font-body font-semibold py-3 px-8 rounded-md border border-indigo transition-all duration-300 hover:bg-indigo hover:text-linen focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-linen focus-visible:ring-indigo"
                    >
                      Inquire about this
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </ScrollFadeIn>
        ))}
      </div>

      <!-- Pricing -->
      <ScrollFadeIn delay={0}>
        <div class="mt-20 max-w-[700px]">
          <h2 class="font-mono text-[13px] uppercase tracking-[0.05em] text-slate-blue opacity-80 mb-4">
            How Pricing Works
          </h2>
          <p class="font-body text-[18px] md:text-[20px] text-slate-blue leading-relaxed">
            Every engagement is fixed-fee and quoted after the diagnostic call — no hourly meters, no scope creep. Founding-client pricing is in effect through 2026.
          </p>
        </div>
      </ScrollFadeIn>
    </div>
  </div>

  <BottomCTA />
</BaseLayout>

<script>
  function initAccordion() {
    const items = document.querySelectorAll(".service-item");

    items.forEach((item) => {
      const trigger = item.querySelector(".service-trigger") as HTMLButtonElement | null;
      const body = item.querySelector(".service-body") as HTMLElement | null;
      const chevron = item.querySelector(".service-chevron svg") as SVGElement | null;

      if (!trigger || !body) return;

      trigger.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";

        // Close all other items (one-open-at-a-time)
        items.forEach((other) => {
          if (other === item) return;
          const otherTrigger = other.querySelector(".service-trigger") as HTMLButtonElement | null;
          const otherBody = other.querySelector(".service-body") as HTMLElement | null;
          const otherChevron = other.querySelector(".service-chevron svg") as SVGElement | null;
          if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
          if (otherBody) {
            otherBody.classList.remove("grid-rows-[1fr]", "opacity-100");
            otherBody.classList.add("grid-rows-[0fr]", "opacity-0");
          }
          if (otherChevron) otherChevron.style.transform = "";
        });

        // Toggle current
        if (isOpen) {
          trigger.setAttribute("aria-expanded", "false");
          body.classList.remove("grid-rows-[1fr]", "opacity-100");
          body.classList.add("grid-rows-[0fr]", "opacity-0");
          if (chevron) chevron.style.transform = "";
        } else {
          trigger.setAttribute("aria-expanded", "true");
          body.classList.remove("grid-rows-[0fr]", "opacity-0");
          body.classList.add("grid-rows-[1fr]", "opacity-100");
          if (chevron) chevron.style.transform = "rotate(180deg)";
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAccordion);
  } else {
    initAccordion();
  }
</script>
