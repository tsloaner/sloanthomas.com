  <BottomCTA />
</BaseLayout>

<script>
  function initAccordions() {
    const groups = document.querySelectorAll(".accordion-group");

    groups.forEach((group) => {
      const items = group.querySelectorAll(".accordion-item");

      items.forEach((item) => {
        const trigger = item.querySelector(
          ".accordion-trigger"
        ) as HTMLButtonElement | null;
        const body = item.querySelector(
          ".accordion-body"
        ) as HTMLElement | null;
        const chevron = item.querySelector(
          ".accordion-chevron svg"
        ) as SVGElement | null;

        if (!trigger || !body) return;

        trigger.addEventListener("click", () => {
          const isOpen = trigger.getAttribute("aria-expanded") === "true";

          // Close other items in the same group (one-open-at-a-time)
          items.forEach((other) => {
            if (other === item) return;
            const oTrigger = other.querySelector(
              ".accordion-trigger"
            ) as HTMLButtonElement | null;
            const oBody = other.querySelector(
              ".accordion-body"
            ) as HTMLElement | null;
            const oChevron = other.querySelector(
              ".accordion-chevron svg"
            ) as SVGElement | null;
            if (oTrigger) oTrigger.setAttribute("aria-expanded", "false");
            if (oBody) {
              oBody.classList.remove("grid-rows-[1fr]", "opacity-100");
              oBody.classList.add("grid-rows-[0fr]", "opacity-0");
            }
            if (oChevron) oChevron.style.transform = "";
          });

          // Toggle current
          if (isOpen) {
            trigger.setAttribute("aria-expanded", "false");
            body.classList.remove("grid-rows-[1fr]", "opacity-100");
            body.classList.add("grid-rows-[0fr]", "opacity-0");
            if (chevron) chevron.style.transform = "";
          } else {
            trigger.setAttribute("aria-expanded", "true");
            body.classList.remove("grid-rows-[0fr]", "opacity-0");
            body.classList.add("grid-rows-[1fr]", "opacity-100");
            if (chevron) chevron.style.transform = "rotate(180deg)";
          }
        });
      });
    });
  }

  // Keep the Boolean-explainer popover clamped inside the viewport, no matter
  // where the trigger word lands on its line.
  function initBoolTips() {
    document.querySelectorAll(".bool-tip").forEach((tip) => {
      const trigger = tip.querySelector(".bool-trigger") as HTMLElement | null;
      const pop = tip.querySelector(".bool-pop") as HTMLElement | null;
      if (!trigger || !pop) return;

      const place = () => {
        pop.style.left = "0px";
        const wordLeft = trigger.getBoundingClientRect().left;
        const margin = 16;
        const vw = document.documentElement.clientWidth;
        const target = Math.min(
          Math.max(wordLeft, margin),
          Math.max(margin, vw - pop.offsetWidth - margin)
        );
        pop.style.left = `${target - wordLeft}px`;
      };

      trigger.addEventListener("mouseenter", place);
      trigger.addEventListener("focus", place);
      tip.addEventListener("mouseenter", place);
    });
  }

  function init() {
    initAccordions();
    initBoolTips();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
